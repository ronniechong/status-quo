---
import Layout from "../layouts/Layout.astro";
import { loadMeta, loadIncidents, loadCoverage } from "../lib/loader";
import { css } from "../../styled-system/css";
import Dashboard from "../components/Dashboard/Dashboard";
import HowThisWorksLink from "../components/HowThisWorks/HowThisWorksLink";

const meta = loadMeta();
const allIncidents = loadIncidents();
const coverage = loadCoverage();

const dataAsOf = new Date(meta.generated_at_utc);
const dataAsOfLabel = `${dataAsOf.toISOString().slice(0, 10)} ${dataAsOf.toISOString().slice(11, 16)} UTC`;
---

<Layout>
	<div class={css({ maxW: "900px", mx: "auto", px: "4", py: "6", fontFamily: "system-ui, sans-serif", color: "gray.900" })}>
		<header class={css({ display: "flex", justifyContent: "space-between", alignItems: "flex-start", pb: "4" })}>
			<div>
				<h1 class={css({ fontSize: "2xl", fontWeight: "600", m: "0" })}>Status Quo</h1>
				<p class={css({ color: "gray.500", fontSize: "sm", m: "0" })}>Incident patterns across the services you depend on</p>
			</div>
			<div class={css({ fontFamily: "monospace", fontSize: "xs", color: "gray.500", textAlign: "right" })}>
				Data as of<br />
				<strong>{dataAsOfLabel}</strong>
			</div>
		</header>

		<div
			class={css({
				display: "flex",
				justifyContent: "space-between",
				borderTop: "1px solid",
				borderColor: "gray.200",
				borderBottom: "1px solid",
				py: "2",
				fontSize: "sm",
				color: "gray.600",
			})}
		>
			<span>
				Summaries generated by <code>{meta.default_model}</code>, prompt <code>{meta.default_prompt_version}</code>, schema{" "}
				<code>{meta.default_schema_version}</code> — exceptions flagged per incident
			</span>
			<span class={css({ color: "blue.700" })}>
				<HowThisWorksLink client:load defaultModel={meta.default_model} defaultPromptVersion={meta.default_prompt_version} />
			</span>
		</div>

		<Dashboard client:load incidents={allIncidents} coverage={coverage} dataAsOfLabel={dataAsOfLabel} />

		<footer class={css({ fontSize: "xs", color: "gray.500", borderTop: "1px solid", borderColor: "gray.200", pt: "3", mt: "4" })}>
			Incident data is collected from each provider's public status page and linked to source. Not affiliated with, or endorsed
			by, any provider shown.
		</footer>
	</div>
</Layout>
