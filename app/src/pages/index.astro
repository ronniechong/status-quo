---
import Layout from "../layouts/Layout.astro";
import { css } from "../../styled-system/css";
import App from "../components/App/App";
import DataAsOf from "../components/DataAsOf/DataAsOf";
import LogoMark from "../assets/logo-mark.svg?raw";
---

<Layout>
	<div class={css({ bg: "cream.50", minH: "100vh" })}>
		<header class={css({ bg: "white", borderBottom: "1px solid", borderColor: "cream.300" })}>
			<div
				class={css({
					maxW: "900px",
					mx: "auto",
					px: "4",
					py: "5",
					display: "flex",
					flexWrap: "wrap",
					gap: "3",
					justifyContent: "space-between",
					alignItems: "flex-start",
					fontFamily: "system-ui, sans-serif",
				})}
			>
				<div class={css({ display: "flex", alignItems: "center", gap: "3" })}>
					<span class={css({ color: "ink.900", flexShrink: "0" })} set:html={LogoMark} />
					<div>
						<h1 class={css({ fontSize: "2xl", fontWeight: "600", m: "0", color: "ink.900" })}>Status Quo</h1>
						<p class={css({ color: "ink.700", fontSize: "sm", m: "0" })}>Incident patterns across the services you depend on</p>
					</div>
				</div>
				<div class={css({ fontFamily: "monospace", fontSize: "xs", color: "ink.700", textAlign: "right" })}>
					Data as of<br />
					<DataAsOf client:load />
				</div>
			</div>
		</header>

		<div class={css({ maxW: "900px", mx: "auto", px: "4", py: "6", fontFamily: "system-ui, sans-serif", color: "ink.900" })}>
			<App client:load />

			<footer class={css({ fontSize: "xs", color: "ink.700", borderTop: "1px solid", borderColor: "cream.300", pt: "3", mt: "4" })}>
				<p class={css({ m: "0", mb: "2" })}>
					Incident data is collected from each provider's public status page and linked to source. Incident text remains the
					copyright of the respective providers and is not republished here. Not affiliated with, or endorsed by, any provider
					shown.
				</p>
				<div class={css({ display: "flex", gap: "3" })}>
					<a href="#/how-this-works" class={css({ color: "blue.700" })}>
						How this works
					</a>
					<a href="https://github.com/ronniechong/status-quo" class={css({ color: "blue.700" })}>
						Source code
					</a>
				</div>
			</footer>
		</div>
	</div>
</Layout>
