---
import Layout from "../layouts/Layout.astro";
import { loadMeta, loadIncidents, loadCoverage, withinWindow, medianDurationHours, formatDuration, dailyCounts } from "../lib/data";
import { css } from "../../styled-system/css";
import TrendChart from "../components/TrendChart";

const meta = loadMeta();
const allIncidents = loadIncidents();
const coverage = loadCoverage();

// Default window per spec §8: 7 days.
const WINDOW_DAYS = 7;
const windowIncidents = withinWindow(allIncidents, 24 * WINDOW_DAYS);
const trend = dailyCounts(allIncidents, 30);
const providersAffected = new Set(windowIncidents.map((i) => i.provider_id)).size;
const openIncidents = allIncidents.filter((i) => i.is_open);
const median = medianDurationHours(windowIncidents.filter((i) => !i.is_open));

const dataAsOf = new Date(meta.generated_at_utc);
const dataAsOfLabel = `${dataAsOf.toISOString().slice(0, 10)} ${dataAsOf.toISOString().slice(11, 16)} UTC`;

const feed = windowIncidents.slice(0, 20);
---

<Layout>
	<div class={css({ maxW: "900px", mx: "auto", px: "4", py: "6", fontFamily: "system-ui, sans-serif", color: "gray.900" })}>
		<header class={css({ display: "flex", justifyContent: "space-between", alignItems: "flex-start", pb: "4" })}>
			<div>
				<h1 class={css({ fontSize: "2xl", fontWeight: "600", m: "0" })}>Status Quo</h1>
				<p class={css({ color: "gray.500", fontSize: "sm", m: "0" })}>Incident patterns across the services you depend on</p>
			</div>
			<div class={css({ fontFamily: "monospace", fontSize: "xs", color: "gray.500", textAlign: "right" })}>
				Data as of<br />
				<strong>{dataAsOfLabel}</strong>
			</div>
		</header>

		<div class={css({ borderTop: "1px solid", borderColor: "gray.200", borderBottom: "1px solid", py: "2", fontSize: "sm", color: "gray.600" })}>
			Summaries generated by <code>{meta.default_model}</code>, prompt <code>{meta.default_prompt_version}</code>, schema{" "}
			<code>{meta.default_schema_version}</code> — exceptions flagged per incident
		</div>

		<section class={css({ display: "grid", gridTemplateColumns: "repeat(4, 1fr)", gap: "3", my: "4" })}>
			<div class={css({ border: "1px solid", borderColor: "gray.200", borderRadius: "md", p: "3" })}>
				<div class={css({ fontSize: "xs", color: "gray.500" })}>Incidents in window</div>
				<div class={css({ fontSize: "xl", fontWeight: "600" })}>{windowIncidents.length}</div>
			</div>
			<div class={css({ border: "1px solid", borderColor: "gray.200", borderRadius: "md", p: "3" })}>
				<div class={css({ fontSize: "xs", color: "gray.500" })}>Providers affected</div>
				<div class={css({ fontSize: "xl", fontWeight: "600" })}>
					{providersAffected}<span class={css({ fontSize: "sm", color: "gray.400" })}>/{coverage.length}</span>
				</div>
			</div>
			<div class={css({ border: "1px solid", borderColor: "gray.200", borderRadius: "md", p: "3" })}>
				<div class={css({ fontSize: "xs", color: "gray.500" })}>Median duration</div>
				<div class={css({ fontSize: "xl", fontWeight: "600" })}>{formatDuration(median)}</div>
			</div>
			<div class={css({ border: "1px solid", borderColor: "gray.200", borderRadius: "md", p: "3" })}>
				<div class={css({ fontSize: "xs", color: "gray.500" })}>Open at last check</div>
				<div class={css({ fontSize: "xl", fontWeight: "600" })}>{openIncidents.length}</div>
			</div>
		</section>

		<section class={css({ my: "4" })}>
			<div class={css({ display: "flex", justifyContent: "space-between", fontSize: "xs", color: "gray.500", mb: "1" })}>
				<span>Incidents per day, last 30 days</span>
				<span>Shaded = selected window</span>
			</div>
			<TrendChart client:load data={trend} selectedWindowDays={WINDOW_DAYS} />
		</section>

		<section class={css({ display: "flex", flexDirection: "column", gap: "3", my: "4" })}>
			{feed.map((incident) => (
				<article class={css({ border: "1px solid", borderColor: "gray.200", borderRadius: "md", p: "3" })}>
					<div class={css({ display: "flex", gap: "2", alignItems: "center", fontSize: "sm" })}>
						<strong>{incident.provider_name}</strong>
						<span
							class={css({
								fontSize: "xs",
								px: "2",
								py: "0.5",
								borderRadius: "full",
								bg: incident.is_open ? "amber.100" : incident.is_retroactive ? "purple.100" : "green.100",
							})}
						>
							{incident.is_open
								? `Open as of ${dataAsOfLabel}`
								: incident.is_retroactive
									? "Published after resolution"
									: "Resolved"}
						</span>
						{incident.severity && (
							<span class={css({ fontSize: "xs", px: "2", py: "0.5", borderRadius: "full", bg: "gray.100", color: "gray.700" })}>
								{incident.provider_name}: {incident.severity}
							</span>
						)}
						{incident.is_provenance_exception && (
							<span class={css({ fontSize: "xs", px: "2", py: "0.5", borderRadius: "full", bg: "orange.100", color: "orange.800" })}>
								{incident.model_used === "none" ? "raw snapshot" : `${incident.model_used} fallback`}
							</span>
						)}
					</div>
					<h3 class={css({ fontSize: "md", fontWeight: "600", my: "1" })}>{incident.title ?? "(untitled)"}</h3>
					{incident.summary && <p class={css({ fontSize: "sm", color: "gray.700", m: "0" })}>{incident.summary}</p>}
					<div class={css({ display: "flex", gap: "2", flexWrap: "wrap", mt: "2" })}>
						{incident.tags.map((tag) => (
							<span class={css({ fontSize: "xs", px: "2", py: "0.5", borderRadius: "full", bg: "gray.100", color: "gray.600" })}>{tag}</span>
						))}
					</div>
					<div class={css({ display: "flex", justifyContent: "space-between", mt: "2", fontSize: "xs" })}>
						<a href={incident.source_url ?? "#"} class={css({ color: "blue.600" })}>
							{incident.source_is_fallback ? "Provider status page" : "Source"}
						</a>
					</div>
				</article>
			))}
		</section>

		<footer class={css({ fontSize: "xs", color: "gray.500", borderTop: "1px solid", borderColor: "gray.200", pt: "3" })}>
			Incident data is collected from each provider's public status page and linked to source. Not affiliated with, or endorsed
			by, any provider shown.
		</footer>
	</div>
</Layout>
