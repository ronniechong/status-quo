---
import Layout from "../layouts/Layout.astro";
import { loadMeta, loadIncidents, loadCoverage } from "../lib/loader";
import { css } from "../../styled-system/css";
import Dashboard from "../components/Dashboard/Dashboard";
import HowThisWorksLink from "../components/HowThisWorks/HowThisWorksLink";
import LogoMark from "../assets/logo-mark.svg?raw";

const meta = loadMeta();
const allIncidents = loadIncidents();
const coverage = loadCoverage();

const dataAsOf = new Date(meta.generated_at_utc);
const dataAsOfLabel = `${dataAsOf.toISOString().slice(0, 10)} ${dataAsOf.toISOString().slice(11, 16)} UTC`;
---

<Layout>
	<div class={css({ bg: "cream.50", minH: "100vh" })}>
		<header class={css({ bg: "white", borderBottom: "1px solid", borderColor: "cream.300" })}>
			<div
				class={css({
					maxW: "900px",
					mx: "auto",
					px: "4",
					py: "5",
					display: "flex",
					flexWrap: "wrap",
					gap: "3",
					justifyContent: "space-between",
					alignItems: "flex-start",
					fontFamily: "system-ui, sans-serif",
				})}
			>
				<div class={css({ display: "flex", alignItems: "center", gap: "3" })}>
					<span class={css({ color: "ink.900", flexShrink: "0" })} set:html={LogoMark} />
					<div>
						<h1 class={css({ fontSize: "2xl", fontWeight: "600", m: "0", color: "ink.900" })}>Status Quo</h1>
						<p class={css({ color: "ink.700", fontSize: "sm", m: "0" })}>Incident patterns across the services you depend on</p>
					</div>
				</div>
				<div class={css({ fontFamily: "monospace", fontSize: "xs", color: "ink.700", textAlign: "right" })}>
					Data as of<br />
					<strong>{dataAsOfLabel}</strong>
				</div>
			</div>
		</header>

		<div class={css({ maxW: "900px", mx: "auto", px: "4", py: "6", fontFamily: "system-ui, sans-serif", color: "ink.900" })}>
			<div
				class={css({
					display: "flex",
					flexWrap: "wrap",
					gap: "2",
					justifyContent: "space-between",
					bg: "cream.100",
					borderRadius: "md",
					px: "3",
					py: "3",
					my: "4",
					fontSize: "sm",
					color: "ink.700",
				})}
			>
				<span>
					Summaries generated by <code>{meta.default_model}</code>, prompt <code>{meta.default_prompt_version}</code>, schema{" "}
					<code>{meta.default_schema_version}</code> — exceptions flagged per incident
				</span>
				<span class={css({ color: "blue.700" })}>
					<HowThisWorksLink client:load defaultModel={meta.default_model} defaultPromptVersion={meta.default_prompt_version} />
				</span>
			</div>

			<Dashboard client:load incidents={allIncidents} coverage={coverage} dataAsOfLabel={dataAsOfLabel} />

			<footer class={css({ fontSize: "xs", color: "ink.700", borderTop: "1px solid", borderColor: "cream.300", pt: "3", mt: "4" })}>
				<p class={css({ m: "0", mb: "2" })}>
					Incident data is collected from each provider's public status page and linked to source. Incident text remains the
					copyright of the respective providers and is not republished here. Not affiliated with, or endorsed by, any provider
					shown.
				</p>
				<div class={css({ display: "flex", gap: "3" })}>
					<a href="#/how-this-works" class={css({ color: "blue.700" })}>
						How this works
					</a>
					<a href="https://github.com/ronniechong/status-quo" class={css({ color: "blue.700" })}>
						Source code
					</a>
				</div>
			</footer>
		</div>
	</div>
</Layout>
