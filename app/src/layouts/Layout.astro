---
import "../styles/index.css";

interface Props {
	title?: string;
}
const { title = "Status Quo" } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Incident patterns across the services you depend on" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
