# Copy to .env and fill in real values. .env is gitignored — never commit it.

# HuggingFace dataset repo id to export collected snapshots to, e.g. "yourname/status-quo-raw".
# The dataset must be created as PRIVATE before the first export runs.
STATUS_QUO_HF_DATASET_REPO=

# HuggingFace access token with write access to the dataset above.
# Create at https://huggingface.co/settings/tokens (Write scope).
HF_TOKEN=

# healthchecks.io check's ping URL, pinged on each successful fetch cycle
# (and with a /fail suffix on failure). Create a check with an expected
# period matching the ~6h fetch cadence, then paste its ping URL here.
HEALTHCHECKS_PING_URL=

# Separate healthchecks.io check for the export job, pinged the same way.
# Create a check with a period matching the ~6h export cadence.
HEALTHCHECKS_EXPORT_PING_URL=

# Groq API key for the interpretation pipeline (openai/gpt-oss-120b primary,
# openai/gpt-oss-20b fallback). Create at https://console.groq.com/keys.
GROQ_API_KEY=

# Optional: Langfuse tracing of interpretation calls (sampled, not every
# call). Leave unset to skip tracing entirely — interpret.py has no hard
# dependency on these being configured.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
